### JWT
ADMIN_AUTH_KEY="secret code for signing admin JWT token"
USER_AUTH_KEY="secret code for signing user JWT token"
### Twilio
AUTH_TOKEN="your Twilio auth token"
ACCOUNT_SID="your Twilio account SID"
SERVICE_SID="your Twilio service SID"
### Razorpay    
RAZOR_PAY_KEY="your Razorpay API test key"
RAZOR_PAY_SECRET="your Razorpay API test secret key"
### Stripe
STRIPE_SECRET="your Stripe account secret key"
STRIPE_PUBLISH_KEY="your Stripe account publish key"
STRIPE_WEBHOOK="your Stripe account webhook key"
### Google Auth
GOAUTH_CLIENT_ID="your Google OAuth client ID"
GOAUTH_CLIENT_SECRET="your Google OAuth client secret"
GOAUTH_CALL_BACK_URL="your Google OAuth callback URL"
### Elasticsearch
ELASTICSEARCH_URL="your Elasticsearch URL"
### Firebase (service account for FCM push + Firestore watcher)
# Option A: point to the JSON file (recommended for local dev)
GOOGLE_APPLICATION_CREDENTIALS="your Google application credentials JSON file"
# Option B: inline JSON (recommended for Docker / CI)
# FIREBASE_CONFIG='{"type":"service_account","project_id":"your project ID",...}'
# PII encryption keyring (AES-256-GCM)
PII_ENCRYPTION_KEYS=your base64-encoded AES-256-GCM keyring
PII_ENCRYPTION_ACTIVE_KEY=your active key ID from the keyring
# ===== Object Storage (Utho S3-compatible) — REHEARSAL bucket =====
S3_ENDPOINT=https://innoida.utho.io
S3_REGION=ap-south-in-noida-1
S3_BUCKET=locazar-dev
S3_ACCESS_KEY=your S3 access key
S3_SECRET_KEY=your S3 secret key
S3_PUBLIC_BASE_URL=https://innoida.utho.io/locazar-dev

TWO_FACTOR_API_KEY=your_2factor_api_key
