# Database
DB_HOST=localhost
DB_NAME=locazar_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Admin
ADMIN_EMAIL=admin@locazar.com
ADMIN_PASSWORD=admin123

# JWT
ADMIN_AUTH_KEY=admin-secret-key-change-me
USER_AUTH_KEY=user-secret-key-change-me

# Twilio
AUTH_TOKEN=your_twilio_auth_token
ACCOUNT_SID=your_twilio_account_sid
SERVICE_SID=your_twilio_service_sid

# Razorpay
RAZOR_PAY_KEY=rzp_test_xxxxxxxxxxxx
RAZOR_PAY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe
STRIPE_SECRET=your_stripe_secret
STRIPE_PUBLISH_KEY=your_stripe_publish_key
STRIPE_WEBHOOK=your_stripe_webhook_secret

# Google OAuth
GOAUTH_CLIENT_ID=your_google_client_id
GOAUTH_CLIENT_SECRET=your_google_client_secret
GOAUTH_CALL_BACK_URL=http://localhost:3000/auth/google/callback

# Object Storage (Utho S3-compatible)
S3_ENDPOINT=https://innoida.utho.io
S3_REGION=ap-south-in-noida-1
S3_BUCKET=locazar
S3_ACCESS_KEY=your_utho_access_key
S3_SECRET_KEY=your_utho_secret_key
# Optional: override the public URL prefix (defaults to <S3_ENDPOINT>/<S3_BUCKET>)
S3_PUBLIC_BASE_URL=

# Legacy AWS_* — accepted as fallback for one release; remove after Phase G ships
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# Shared Uploads (deprecated; will be removed)
SHARED_UPLOADS_PATH=./uploads

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# AI Service
AI_SERVICE_URL=http://localhost:3001

# PII encryption (REQUIRED). Keyring of "<id>:<base64-32-byte-key>" entries,
# comma-separated; PII_ENCRYPTION_ACTIVE_KEY selects the key used for new writes.
# Generate a key with: head -c 32 /dev/urandom | base64
# The server fails to start if these are unset or invalid.
# WARNING: losing the active key makes all encrypted PII permanently unrecoverable — provision this in EVERY environment before deploy.
PII_ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTE_KEY
PII_ENCRYPTION_ACTIVE_KEY=v1
