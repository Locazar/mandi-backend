rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /enquiry/{docId} {
      allow read, write: if request.auth != null;

      // Chat messages live in a SUBCOLLECTION under each enquiry document.
      // Rules do not cascade — without this nested match the messages path
      // falls through to the global deny and every send fails.
      match /inquiry_messages/{messageId} {
        allow read, create, update: if true;
        allow delete: if false;
      }
    }

    match /inquiry_messages/{docId} {
      allow read, write: if request.auth != null;
    }

    match /product_availability_queries/{docId} {
      allow read, write: if request.auth != null;
    }

    match /shop_status_queries/{docId} {
      allow read, write: if request.auth != null;
    }

    match /sellers/{docId} {
      allow read, write: if request.auth != null;

      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null;
      }
    }
    
     // Public website enquiries: create only, no reads/updates/deletes.
    match /website_enquiries/{docId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'phone', 'city', 'state', 'source', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.city is string &&
        request.resource.data.state is string &&
        (!('address' in request.resource.data) || request.resource.data.address is string) &&
        (!('message' in request.resource.data) || request.resource.data.message is string) &&
        request.resource.data.source is string;

      allow read, update, delete: if false;
    }
    
   match /enquiry/{enquiryId} { allow read: if true; allow create, update: if true; allow delete: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
