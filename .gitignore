# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/config

.air.toml

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/
build/bin/

# Go workspace file
go.work

# Environment file
*.env

# REST Client file
*.http

# MACOSX file
.DS_Store

# Code Coverage
code-coverage.*

# Firebase / Google Cloud service account credentials
locazar-*.json
*-credentials.json
*-service-account.json
service-account*.json

# Log files
*.log
stderr.log
stdout.log
/main

# Compiled binaries at repo root / build output
/api
/build/api

# Database dumps and scratch files
/backup.sql
/mandi_backup.sql
*.dump
/query
/seed

# Temp directory
/tmp

# Shell config accidentally created at repo root
/.bashrc

# Local upload directories (real ./uploads/ + any safety backups) — not source
/uploads*/

# Planning artifacts kept local-only
/spec/

