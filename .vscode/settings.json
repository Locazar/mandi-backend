{
  // Go extension settings for language and linting support
  "go.lintOnSave": "package",
  "go.lintTool": "golangci-lint",
  "go.lintFlags": ["--timeout=5m"],
  "go.toolsManagement.autoUpdate": true,
  "go.testFlags": ["-v"],
  // gopls settings
  "gopls": {
    "gofumpt": true,
    "local": "github.com/rohit221990/mandi-backend",
    "semanticTokens": true,
    "staticcheck": true
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  // Go settings for better definition/reference support
  "go.lintOnChange": "off",
  "go.coverOnSave": false,
  "editor.formatOnSave": true,
  // File watching exclusions (reduces lag)
  "files.exclude": {
    "**/build": true,
    "**/vendor": true,
    "**/.git": true
  },
  // Extension exclusions
  "files.watcherExclude": {
    "**/build/**": true,
    "**/vendor/**": true,
    "**/.git/**": true,
    "**/.mod": true
  },
  "cSpell.words": ["repointerfaces", "TIMESTAMPTZ"]
}
